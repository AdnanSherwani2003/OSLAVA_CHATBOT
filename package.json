{
  "name": "oslava-admin-ai",
  "version": "1.0.0",
  "description": "Standalone Oslava Admin AI Chatbot Backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "chat": "tsx src/dev/chat-cli.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:groq": "vitest run tests/integration/groq",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/persistence/migrate.ts"
  },
  "keywords": [
    "oslava",
    "admin",
    "ai",
    "fastify",
    "supabase"
  ],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "groq-sdk": "^1.6.0",
    "openai": "7.15.0",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
