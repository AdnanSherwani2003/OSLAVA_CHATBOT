# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Supabase Gateway Configuration (Client-side / Anon / Publishable key)
# DO NOT set SUPABASE_SERVICE_ROLE_KEY. Chatbot uses user-scoped JWT propagation only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# SUPABASE_ANON_KEY is also accepted as a fallback if your project uses anon key naming:
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Dedicated Chatbot Database (Separate PostgreSQL instance)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oslava_chatbot

# Groq Model Provider (openai/gpt-oss-120b)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
GROQ_MAX_OUTPUT_TOKENS=2000
GROQ_TIMEOUT_MS=30000

# Conversation Context
CHAT_HISTORY_MESSAGE_LIMIT=16

# Observability & Networking
LOG_LEVEL=info
CORS_ORIGINS=*
REQUEST_TIMEOUT_MS=15000
