# ==============================================================================
# Oslava Admin AI Chatbot Backend - Environment Configuration
# ==============================================================================

# Application Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_TIMEZONE=Asia/Kolkata

# Supabase Gateway Configuration (User-scoped client access only)
# IMPORTANT: DO NOT provide SUPABASE_SERVICE_ROLE_KEY. The chatbot operates strictly
# under the calling Admin's JWT credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Chatbot Persistence Mode
# Options: "memory" (dev / testing / CLI) | "postgres" (production / staging)
# Production rule: When NODE_ENV=production, CHAT_PERSISTENCE_MODE must be "postgres"
# unless ALLOW_EPHEMERAL_PRODUCTION_PERSISTENCE=true is explicitly set.
CHAT_PERSISTENCE_MODE=memory
ALLOW_EPHEMERAL_PRODUCTION_PERSISTENCE=false

# Dedicated Chatbot PostgreSQL Database
# Required when CHAT_PERSISTENCE_MODE=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oslava_chatbot
DATABASE_POOL_MAX=3

# Primary AI Provider (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_TIMEOUT_MS=20000

# Fallback AI Provider (Groq)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
GROQ_MAX_OUTPUT_TOKENS=2000
GROQ_TIMEOUT_MS=20000

# AI Provider Routing
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_ENABLED=true
AI_MAX_TOOL_CALLS=8

# Conversation & Confirmation Parameters
CHAT_HISTORY_MESSAGE_LIMIT=16
ACTION_CONFIRMATION_TTL_SECONDS=600

# Networking, Deadlines & Tool Execution Timeouts
REQUEST_TIMEOUT_MS=60000
CHAT_TURN_TIMEOUT_MS=45000
TOOL_EXECUTION_TIMEOUT_MS=10000
CORS_ORIGINS=*

# Production Rate Limiting (Separate limits per capability area)
# Defaults: 20 chat turns/min, 10 action confirms/min, 10 session creations/min, 100 general req/min
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

ACTION_RATE_LIMIT_REQUESTS=10
ACTION_RATE_LIMIT_WINDOW_SECONDS=60

SESSION_RATE_LIMIT_REQUESTS=10
SESSION_RATE_LIMIT_WINDOW_SECONDS=60

GENERAL_RATE_LIMIT_REQUESTS=100
GENERAL_RATE_LIMIT_WINDOW_SECONDS=60
